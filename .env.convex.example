# LazyBill - Convex Environment Variables
# Set these in the Convex dashboard: https://dashboard.convex.dev
# Or via CLI: npx convex env set VARIABLE_NAME "value"

# ============================================
# REQUIRED
# ============================================

# Site URL for authentication callbacks
# Use your production URL or http://localhost:5173 for development
SITE_URL=https://your-domain.com

# Google OAuth credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# OPTIONAL
# ============================================

# Resend API key for sending emails (beta invitations)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Telegram bot for notifications (new signups, feedback)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789
