# LazyBill - SvelteKit Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# PUBLIC VARIABLES (exposed to browser)
# ============================================

# Convex deployment URL (get from Convex dashboard or `npx convex dev`)
PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# PostHog analytics (optional, leave empty to disable)
PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Maps Places API key (for address autocomplete)
PUBLIC_GOOGLE_MAPS_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# PRIVATE VARIABLES (server-side only)
# ============================================

# Stripe API keys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
